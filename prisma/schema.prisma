// Hardware ERP — data model
//
// Conventions:
//  * Money is Decimal(12,2). Never Float — binary floats cannot represent
//    currency exactly and the errors compound across a ledger.
//  * Quantities are Decimal(12,3). The shop sells paint, cement and wire by
//    weight and length, so fractional quantities are normal; Float would drift
//    and leave batches stranded at 0.0000001.
//  * Status columns are enums, not free text, so an invalid state cannot be
//    written at all.
//  * Every foreign key is indexed. PostgreSQL does not index FK columns
//    automatically and Prisma does not add them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
//  NextAuth models
//  Retained for compatibility with the NextAuth schema. The app uses the JWT
//  session strategy with no PrismaAdapter, so these are currently unwritten.
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
//  Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  MANAGER
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  CHEQUE
  BANK_TRANSFER
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  SALE
  RETURN
  PURCHASE
  MIXING
  ADJUSTMENT
}

// ─────────────────────────────────────────────
//  Core models
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CASHIER)
  /// Soft disable. Staff who have raised bills cannot be deleted, so accounts
  /// are deactivated instead; login is refused when false.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bills             Bill[]
  stockMovements    StockMovement[]
  warrantyClaims    WarrantyClaim[]
  moneyTransactions MoneyTransaction[]
  cashCounts        CashCount[]

  @@index([role])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  nic       String?  @unique
  phone     String?
  email     String?  @unique
  address   String?
  /// Archive flag. Customers with financial history must never be deleted —
  /// doing so would orphan their bills and erase the debt trail.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills      Bill[]
  payments   Payment[]
  cheques    Cheque[]
  warranties Warranty[]

  @@index([name])
  @@index([isActive])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?  @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  purchaseBatches  PurchaseBatch[]
  warranties       Warranty[]

  @@index([name])
  @@index([isActive])
}

model Item {
  id           String  @id @default(uuid())
  barcode      String  @unique
  name         String
  description  String?
  category     String?
  unit         String  @default("pcs")
  /// Master stock level. Invariant: equals the sum of remainingQty across this
  /// item's purchase batches. Enforced by a CHECK constraint (>= 0) and by
  /// always mutating both in the same transaction.
  stockQty     Decimal @default(0) @db.Decimal(12, 3)
  reorderLevel Int     @default(5)
  buyingPrice  Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)
  isActive     Boolean @default(true)

  // ── Warranty configuration ──
  // Gate 1: can this product carry a warranty at all? A drill can; a bag of
  // cement cannot. Nothing else in the warranty flow switches on unless this
  // is true.
  warrantyEligible      Boolean @default(false)
  /// Typical term the supplier gives for this product, used to prefill restock.
  defaultWarrantyMonths Int?
  /// Whether a serial number must be captured per unit at the till.
  requiresSerial        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItems       BillItem[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]
  purchaseBatches PurchaseBatch[]
  warranties      Warranty[]

  @@index([name])
  @@index([category])
  @@index([isActive])
  @@index([stockQty])
}

model Bill {
  id          String     @id @default(uuid())
  billNumber  String     @unique
  customerId  String?
  userId      String
  /// Derived from the payment ledger on every write — never set by the client.
  status      BillStatus @default(PENDING)
  subtotal    Decimal    @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  tax         Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @db.Decimal(12, 2)
  /// Always equals the sum of this bill's payments.
  amountPaid  Decimal    @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  billItems  BillItem[]
  payments   Payment[]
  cheques    Cheque[]
  warranties Warranty[]

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  itemId      String
  batchId     String?
  quantity    Decimal @db.Decimal(12, 3)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  /// Cost of goods at the moment of sale, captured from the batch so that
  /// later price changes cannot rewrite historical margin.
  buyingPrice Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  item       Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch      PurchaseBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  warranties Warranty[]

  @@index([billId])
  @@index([itemId])
  @@index([batchId])
}

model Payment {
  id         String        @id @default(uuid())
  billId     String
  customerId String?
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  reference  String?
  /// Set when this payment reverses another (a refund or a bounced cheque).
  reversesId String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  bill     Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([customerId])
  @@index([paidAt])
}

model Cheque {
  id           String       @id @default(uuid())
  billId       String
  customerId   String?
  chequeNumber String
  bank         String
  amount       Decimal      @db.Decimal(12, 2)
  chequeDate   DateTime
  depositDate  DateTime?
  status       ChequeStatus @default(PENDING)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bill     Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([customerId])
  @@index([status])
  @@index([chequeDate])
}

model PurchaseOrder {
  id            String                @id @default(uuid())
  orderNumber   String                @unique
  supplierId    String
  status        OrderStatus           @default(DRAFT)
  /// Derived from the supplier payment ledger — never set by the client.
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  totalAmount   Decimal               @db.Decimal(12, 2)
  /// Always equals the sum of this order's supplier payments.
  amountPaid    Decimal               @default(0) @db.Decimal(12, 2)
  notes         String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseItems    PurchaseItem[]
  supplierPayments SupplierPayment[]
  purchaseBatches  PurchaseBatch[]

  @@index([supplierId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
}

model PurchaseItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Decimal @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(12, 2)
  totalCost       Decimal @db.Decimal(12, 2)
  receivedQty     Decimal @default(0) @db.Decimal(12, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([itemId])
}

model SupplierPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String
  supplierId      String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(CASH)

  /// How much of this payment physically came out of the shop drawer.
  ///
  /// Paying a supplier "in cash" does not mean the money came from the till —
  /// it often comes from the owner's wallet or a bank transfer, and is
  /// routinely split between the two. A yes/no flag cannot express that, so
  /// the drawer's share is recorded as an amount and only this much is taken
  /// off cash in hand. 0 means none of it came from the till.
  drawerAmount Decimal @default(0) @db.Decimal(14, 2)

  reference  String?
  /// Set when this payment reverses another (a bounced cheque).
  reversesId String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  purchaseOrder  PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierCheque SupplierCheque?

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([paidAt])
}

model SupplierCheque {
  id                String       @id @default(uuid())
  supplierPaymentId String       @unique
  chequeNumber      String
  bank              String
  amount            Decimal      @db.Decimal(12, 2)
  chequeDate        DateTime
  passedDate        DateTime?
  status            ChequeStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([chequeDate])
  @@index([chequeNumber])
}

model StockMovement {
  id        String            @id @default(uuid())
  itemId    String
  type      StockMovementType
  /// Signed: negative for stock leaving, positive for stock arriving.
  quantity  Decimal           @db.Decimal(12, 3)
  /// Stock level immediately after this movement, for point-in-time audit.
  balance   Decimal           @db.Decimal(12, 3)
  purpose   String?
  note      String?
  /// Who caused the movement, and which document it belongs to.
  userId    String?
  billId    String?
  createdAt DateTime          @default(now())

  item Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([purpose])
}

model PurchaseBatch {
  id              String  @id @default(uuid())
  itemId          String
  /// Traceability: which delivery and supplier this cost layer came from.
  purchaseOrderId String?
  supplierId      String?
  quantity        Decimal @db.Decimal(12, 3)
  remainingQty    Decimal @db.Decimal(12, 3)
  buyingPrice     Decimal @db.Decimal(12, 2)
  sellingPrice    Decimal @db.Decimal(12, 2)

  // ── Warranty (gate 2) ──
  // Warranty terms are agreed per shipment, not per product, so they live on
  // the batch. A null warrantyMonths means this stock came with no supplier
  // warranty, and therefore none can be issued to a customer from it.
  warrantyMonths      Int?
  supplierWarrantyRef String?

  createdAt DateTime @default(now())

  item          Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  billItems     BillItem[]
  warranties    Warranty[]

  @@index([itemId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  // Drives the FIFO lookup: oldest batch with stock remaining, per item.
  @@index([itemId, remainingQty, createdAt])
}

/// Source of sequential document numbers. Incremented inside the same
/// transaction as the document it numbers, so numbers are gapless under
/// concurrency and cannot collide.
model DocumentCounter {
  id    String @id
  value Int    @default(0)
}

// ─────────────────────────────────────────────
//  Warranty
//  Merged from the update/warranty branch.
// ─────────────────────────────────────────────

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum ClaimStatus {
  RECEIVED
  SENT_TO_SUPPLIER
  SUPPLIER_APPROVED
  SUPPLIER_REJECTED
  RESOLVED
  REJECTED
}

enum ClaimResolution {
  REPAIR
  REPLACE
  REFUND
  REJECTED
}

// One row per physical unit sold.
model Warranty {
  id             String @id @default(uuid())
  warrantyNumber String @unique

  billItemId String
  billId     String
  itemId     String
  customerId String?

  // Provenance: which batch it came from and who backs it.
  batchId    String?
  supplierId String?

  serialNumber String?

  months    Int
  startDate DateTime // = sale date
  endDate   DateTime

  status WarrantyStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItem BillItem       @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  bill     Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  item     Item           @relation(fields: [itemId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id])
  batch    PurchaseBatch? @relation(fields: [batchId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id])

  claims WarrantyClaim[]

  // A serial is unique per product, but many units legitimately have no
  // serial recorded, and Postgres treats NULLs as distinct — so blanks
  // never collide.
  @@unique([itemId, serialNumber])
  @@index([serialNumber])
  @@index([billId])
  @@index([customerId])
  @@index([endDate])
}

// A customer claim and the shop's matching claim against the supplier are
// one and the same event here, so both sides live on one row.
model WarrantyClaim {
  id          String @id @default(uuid())
  claimNumber String @unique

  warrantyId String

  reportedAt DateTime @default(now())
  issue      String

  status     ClaimStatus      @default(RECEIVED)
  resolution ClaimResolution?

  // ── Supplier side ──
  supplierClaimRef    String?
  sentToSupplierAt    DateTime?
  supplierRespondedAt DateTime?
  supplierNotes       String?

  handledByUserId String?
  resolvedAt      DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warranty      Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  handledByUser User?    @relation(fields: [handledByUserId], references: [id])

  @@index([warrantyId])
  @@index([status])
}

// ─────────────────────────────────────────────
//  Money management
//  Merged from the update/warranty branch.
// ─────────────────────────────────────────────

enum MoneyTxType {
  DEPOSIT // cash drawer  → bank
  WITHDRAWAL // bank         → cash drawer
  EXPENSE // out of the business (rent, salaries, fuel…)
  DONATION // out of the business, given away
  OTHER_INCOME // in from something that is not a sale
  ADJUSTMENT // correction / opening float; amount may be negative
}

model BankAccount {
  id            String  @id @default(uuid())
  name          String // What the owner calls it: "BOC Savings"
  bankName      String?
  accountNumber String?

  // Where the balance started on the day the account was added to the system,
  // so the ledger does not have to be back-filled from the account's opening.
  openingBalance Decimal @default(0) @db.Decimal(14, 2)

  // How much the owner intends to put in on a normal day / month. Purely a
  // yardstick for the summary screen — nothing enforces it.
  dailyTarget   Decimal? @db.Decimal(12, 2)
  monthlyTarget Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions MoneyTransaction[]

  @@index([isActive])
}

model MoneyTransaction {
  id     String      @id @default(uuid())
  type   MoneyTxType
  amount Decimal     @db.Decimal(14, 2)

  // Which side of the business the money sits on. null means the cash drawer.
  // For DEPOSIT/WITHDRAWAL this is the bank end of the move — the other end is
  // always the drawer, so a deposit without a bank makes no sense.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Free-form on purpose: a hardware shop's spending categories change faster
  // than a migration can keep up with.
  category    String?
  description String?
  reference   String?

  occurredAt DateTime @default(now())

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurredAt])
  @@index([type])
  @@index([bankAccountId])
}

// One drawer count, normally at the end of the day.
//
// The point of a count is not to tell the system what is in the drawer — it
// already knows what *should* be there. The point is the gap between the two.
// A silent re-baseline would swallow that gap, so the variance is stored and
// the expected figure is frozen as it stood at the moment of counting.
model CashCount {
  id String @id @default(uuid())

  // The shop day counted. One count per day replaces the previous one.
  countedFor DateTime @unique

  expectedAmount Decimal @db.Decimal(14, 2)
  countedAmount  Decimal @db.Decimal(14, 2)

  // counted − expected. Negative means the drawer is short.
  variance Decimal @db.Decimal(14, 2)

  reason String?

  countedByUserId String?
  countedByUser   User?   @relation(fields: [countedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countedFor])
}

// Cash in hand is a running total, so it can only be trusted from a point the
// owner actually counted the drawer. Without this, the figure would reach back
// through every cash sale the shop ever made and every cash payment it ever
// sent out — years of history that never sat in today's drawer — and come out
// as a large, meaningless number.
//
// One row, id "default".
model MoneySettings {
  id String @id @default("default")

  // The day the drawer was counted. Nothing before it counts towards cash.
  cashTrackingStartDate DateTime?

  // What was physically in the drawer on that morning.
  openingCashFloat Decimal @default(0) @db.Decimal(14, 2)

  updatedAt DateTime @default(now()) @updatedAt
}
