// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
//  NextAuth Required Models
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
//  Core ERP Models
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  CASHIER
  MANAGER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CASHIER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  bills    Bill[]

  warrantyClaims    WarrantyClaim[]
  moneyTransactions MoneyTransaction[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  nic       String?  @unique
  phone     String?
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills      Bill[]
  payments   Payment[]
  cheques    Cheque[]
  warranties Warranty[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?  @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  purchaseBatches  PurchaseBatch[]
  warranties       Warranty[]
}

model Item {
  id           String   @id @default(uuid())
  barcode      String   @unique
  name         String
  description  String?
  category     String?
  unit         String   @default("pcs")
  stockQty     Float    @default(0)
  reorderLevel Int      @default(5)
  buyingPrice  Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── WARRANTY ──
  // Gate 1: is this product the kind of thing that can carry a warranty at all?
  // A drill is; a bag of cement is not. Nothing else in the warranty flow
  // switches on unless this is true.
  warrantyEligible      Boolean @default(false)
  // Typical term the supplier gives for this product, used to prefill restock.
  defaultWarrantyMonths Int?
  // Whether a serial must be captured per unit at the till.
  requiresSerial        Boolean @default(true)

  billItems       BillItem[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]
  purchaseBatches PurchaseBatch[]
  warranties      Warranty[]
}

model Bill {
  id          String   @id @default(uuid())
  billNumber  String   @unique
  customerId  String?
  userId      String
  status      String   @default("PENDING") // PENDING | PAID | PARTIAL | CANCELLED
  subtotal    Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(12, 2) // NEW: Tracks exactly how much the customer paid
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  billItems  BillItem[]
  payments   Payment[]
  cheques    Cheque[]
  warranties Warranty[]
}

model BillItem {
  id String @id @default(uuid())

  billId String
  itemId String

  quantity    Float
  returnedQty Float @default(0)

  unitPrice Decimal @db.Decimal(12, 2)

  // NEW
  buyingPrice Decimal @default(0) @db.Decimal(12, 2)

  // NEW
  batchId String?

  discount Decimal @default(0) @db.Decimal(12, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  item Item @relation(fields: [itemId], references: [id])

  warranties Warranty[]
}

enum PaymentMethod {
  CASH
  CARD
  CHEQUE
  BANK_TRANSFER
}

model Payment {
  id         String        @id @default(uuid())
  billId     String
  customerId String?
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  reference  String?
  paidAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())

  bill     Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

model Cheque {
  id           String       @id @default(uuid())
  billId       String
  customerId   String?
  chequeNumber String
  bank         String
  amount       Decimal      @db.Decimal(12, 2)
  chequeDate   DateTime
  depositDate  DateTime?
  status       ChequeStatus @default(PENDING)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bill     Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
}

enum OrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  supplierId    String
  status        OrderStatus @default(DRAFT) // Tracks fulfillment (received goods)
  paymentStatus String      @default("UNPAID") // NEW: Tracks financials (UNPAID | PARTIAL | PAID)
  totalAmount   Decimal     @db.Decimal(12, 2)
  amountPaid    Decimal     @default(0) @db.Decimal(12, 2) // NEW: Tracks exactly how much Uncle paid
  notes         String?
  orderedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  purchaseItems    PurchaseItem[]
  supplierPayments SupplierPayment[]
}

model PurchaseItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Float
  unitCost        Decimal @db.Decimal(12, 2)
  totalCost       Decimal @db.Decimal(12, 2)
  receivedQty     Float   @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
}

model SupplierPayment {
  id String @id @default(uuid())

  purchaseOrderId String
  supplierId      String

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod @default(CASH)

  reference String?

  paidAt DateTime @default(now())

  createdAt DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  supplierCheque SupplierCheque?
}

model SupplierCheque {
  id String @id @default(uuid())

  supplierPaymentId String @unique

  chequeNumber String

  bank String

  amount Decimal @db.Decimal(12, 2)

  chequeDate DateTime

  // NEW FIELD
  passedDate DateTime?

  status ChequeStatus @default(PENDING)

  createdAt DateTime @default(now())

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id String @id @default(uuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  type     String
  quantity Float

  note String?

  // NEW
  purpose String?

  createdAt DateTime @default(now())
}

model PurchaseBatch {
  id String @id @default(uuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity     Float
  remainingQty Float

  buyingPrice  Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  // ── WARRANTY (Gate 2) ──
  // Warranty terms are agreed per shipment, not per product, so they live on
  // the batch. null warrantyMonths means this stock came with no supplier
  // warranty and therefore none can be issued to a customer from it.
  warrantyMonths      Int?
  supplierWarrantyRef String?

  // Who the shop claims against when a customer brings a fault back.
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?

  warranties Warranty[]

  @@index([itemId])
}

// ─────────────────────────────────────────────
//  Warranty
// ─────────────────────────────────────────────
//
// The shop is a pass-through, not the guarantor: a warranty can only be
// issued to a customer if the supplier gave one for that specific batch.
// The customer's clock starts on the day they buy, regardless of how long
// the unit sat on the shelf.

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  VOID
}

enum ClaimStatus {
  RECEIVED
  SENT_TO_SUPPLIER
  SUPPLIER_APPROVED
  SUPPLIER_REJECTED
  RESOLVED
  REJECTED
}

enum ClaimResolution {
  REPAIR
  REPLACE
  REFUND
  REJECTED
}

// One row per physical unit sold.
model Warranty {
  id             String @id @default(uuid())
  warrantyNumber String @unique

  billItemId String
  billId     String
  itemId     String
  customerId String?

  // Provenance: which batch it came from and who backs it.
  batchId    String?
  supplierId String?

  serialNumber String?

  months    Int
  startDate DateTime // = sale date
  endDate   DateTime

  status WarrantyStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItem BillItem       @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  bill     Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  item     Item           @relation(fields: [itemId], references: [id])
  customer Customer?      @relation(fields: [customerId], references: [id])
  batch    PurchaseBatch? @relation(fields: [batchId], references: [id])
  supplier Supplier?      @relation(fields: [supplierId], references: [id])

  claims WarrantyClaim[]

  // A serial is unique per product, but many units legitimately have no
  // serial recorded, and Postgres treats NULLs as distinct — so blanks
  // never collide.
  @@unique([itemId, serialNumber])
  @@index([serialNumber])
  @@index([billId])
  @@index([customerId])
  @@index([endDate])
}

// A customer claim and the shop's matching claim against the supplier are
// one and the same event here, so both sides live on one row.
model WarrantyClaim {
  id          String @id @default(uuid())
  claimNumber String @unique

  warrantyId String

  reportedAt DateTime @default(now())
  issue      String

  status     ClaimStatus      @default(RECEIVED)
  resolution ClaimResolution?

  // ── Supplier side ──
  supplierClaimRef    String?
  sentToSupplierAt    DateTime?
  supplierRespondedAt DateTime?
  supplierNotes       String?

  handledByUserId String?
  resolvedAt      DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warranty      Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  handledByUser User?    @relation(fields: [handledByUserId], references: [id])

  @@index([warrantyId])
  @@index([status])
}

// ─────────────────────────────────────────────
//  Money Management
// ─────────────────────────────────────────────
//
// Sales already live in Payment/SupplierPayment, so nothing here re-records
// takings. This module only tracks what the owner *does* with the money once
// it is in the drawer: what he banks, what he spends, what he gives away.
//
// Two places hold money — the cash drawer, and each BankAccount. Every
// transaction below moves money between those two, or out of the business
// entirely. Balances are never stored; they are summed from the ledger so a
// mis-keyed entry can be deleted and the balance simply corrects itself.

model BankAccount {
  id            String  @id @default(uuid())
  name          String // What the owner calls it: "BOC Savings"
  bankName      String?
  accountNumber String?

  // Where the balance started on the day the account was added to the system,
  // so the ledger does not have to be back-filled from the account's opening.
  openingBalance Decimal @default(0) @db.Decimal(14, 2)

  // How much the owner intends to put in on a normal day / month. Purely a
  // yardstick for the summary screen — nothing enforces it.
  dailyTarget   Decimal? @db.Decimal(12, 2)
  monthlyTarget Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions MoneyTransaction[]

  @@index([isActive])
}

// Cash in hand is a running total, so it can only be trusted from a point the
// owner actually counted the drawer. Without this, the figure would reach back
// through every cash sale the shop ever made and every cash payment it ever
// sent out — years of history that never sat in today's drawer — and come out
// as a large, meaningless number.
//
// One row, id "default".
model MoneySettings {
  id String @id @default("default")

  // The day the drawer was counted. Nothing before it counts towards cash.
  cashTrackingStartDate DateTime?

  // What was physically in the drawer on that morning.
  openingCashFloat Decimal @default(0) @db.Decimal(14, 2)

  updatedAt DateTime @updatedAt @default(now())
}

enum MoneyTxType {
  DEPOSIT // cash drawer  → bank
  WITHDRAWAL // bank         → cash drawer
  EXPENSE // out of the business (rent, salaries, fuel…)
  DONATION // out of the business, given away
  OTHER_INCOME // in from something that is not a sale
  ADJUSTMENT // correction / opening float; amount may be negative
}

model MoneyTransaction {
  id     String      @id @default(uuid())
  type   MoneyTxType
  amount Decimal     @db.Decimal(14, 2)

  // Which side of the business the money sits on. null means the cash drawer.
  // For DEPOSIT/WITHDRAWAL this is the bank end of the move — the other end is
  // always the drawer, so a deposit without a bank makes no sense.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Free-form on purpose: a hardware shop's spending categories change faster
  // than a migration can keep up with.
  category    String?
  description String?
  reference   String?

  occurredAt DateTime @default(now())

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([occurredAt])
  @@index([type])
  @@index([bankAccountId])
}
