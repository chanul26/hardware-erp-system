# ─────────────────────────────────────────────
#  Database (Docker maps host:5433 → container:5432)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5433/hardware_erp?schema=public"

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=hardware_erp

# ─────────────────────────────────────────────
#  NextAuth
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
NEXTAUTH_URL="http://localhost:3001"
