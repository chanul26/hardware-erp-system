# ─────────────────────────────────────────────
#  Copy this file to .env before running anything:
#    cp .env.example .env
#
#  .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
#  Database
#  Docker maps host 5433 -> container 5432, so local tooling uses 5433.
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5433/hardware_erp?schema=public"

# Required by prisma/schema.prisma. Prisma refuses to run without it, including
# `generate`, `db push` and `migrate`. For a plain PostgreSQL setup this is the
# same value as DATABASE_URL; it differs only behind a connection pooler such as
# PgBouncer or Supabase, where DATABASE_URL points at the pooler and DIRECT_URL
# at the database itself.
DIRECT_URL="postgresql://erp_user:erp_password@localhost:5433/hardware_erp?schema=public"

# Consumed by docker-compose.yml when starting the database container.
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=hardware_erp

# ─────────────────────────────────────────────
#  NextAuth
# ─────────────────────────────────────────────
# REQUIRED. The app refuses to start without it.
# Generate a fresh one per environment:  openssl rand -base64 32
# Never reuse the development value in production — anyone holding this secret
# can forge a session token for any user, including an admin.
NEXTAUTH_SECRET="REPLACE_ME_RUN_openssl_rand_base64_32"

# The public origin of the app. Must match how users actually reach it,
# including https:// in production.
NEXTAUTH_URL="http://localhost:3001"

# ─────────────────────────────────────────────
#  Seeding
# ─────────────────────────────────────────────
# Credentials for the first admin account, created by `npm run db:seed`.
# Set these before seeding a production database, and change the password after
# first sign-in. If unset, the seed refuses to run outside development.
SEED_ADMIN_EMAIL="admin@hardware.com"
SEED_ADMIN_PASSWORD=""
